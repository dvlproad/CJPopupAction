{
  "name": "CJPopupAction",
  "version": "1.5.0",
  "summary": "UIView的类别，用来实现UIView弹出popupView的一个UIView的类别",
  "description": "UIView的类别，用来实现UIView弹出popupView的一个UIView的类别。\n支持多种弹出方式：从上方弹出、从下方弹出、从中间弹出等。",
  "homepage": "https://github.com/dvlproad/CJPopupAction",
  "license": "MIT",
  "authors": "dvlproad",
  "platforms": {
    "ios": "9.0"
  },
  "source": {
    "git": "https://github.com/dvlproad/CJPopupAction.git",
    "tag": "CJPopupAction_1.5.0"
  },
  "frameworks": "UIKit",
  "requires_arc": true,
  "subspecs": [
    {
      "name": "Base",
      "source_files": [
        "CJPopupAction/CJPopupCalculator.{h,m}",
        "CJPopupAction/CJPopupBlankModel.{h,m}"
      ]
    },
    {
      "name": "PopupInView",
      "source_files": [
        "CJPopupAction/UIView+CJPopupInView.{h,m}",
        "CJPopupAction/CJPopupViewDelegate.h"
      ],
      "dependencies": {
        "CJPopupAction/Base": []
      }
    },
    {
      "name": "ShowExtendView",
      "source_files": "CJPopupAction/UIView+CJShowExtendView.{h,m}",
      "dependencies": {
        "CJPopupAction/PopupInView": []
      }
    }
  ]
}
