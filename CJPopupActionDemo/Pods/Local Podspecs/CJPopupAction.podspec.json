{
  "name": "CJPopupAction",
  "version": "1.5.0",
  "summary": "UIView的类别，用来实现UIView弹出popupView的一个UIView的类别",
  "description": "UIView的类别，用来实现UIView弹出popupView的一个UIView的类别。\n支持多种弹出方式：从上方弹出、从下方弹出、从中间弹出等。",
  "homepage": "https://github.com/dvlproad/CJPopupAction",
  "license": "MIT",
  "authors": "dvlproad",
  "platforms": {
    "ios": "9.0"
  },
  "source": {
    "git": "https://github.com/dvlproad/CJPopupAction.git",
    "tag": "CJPopupAction_1.5.0"
  },
  "frameworks": "UIKit",
  "requires_arc": true,
  "subspecs": [
    {
      "name": "Core",
      "source_files": "CJPopupAction/Core/**/*.{h,m}"
    },
    {
      "name": "ExpandAnimation",
      "source_files": "CJPopupAction/ExpandAnimation/**/*.{h,m}",
      "dependencies": {
        "CJPopupAction/Core": []
      }
    },
    {
      "name": "SlideAnimation",
      "source_files": "CJPopupAction/SlideAnimation/**/*.{h,m}",
      "dependencies": {
        "CJPopupAction/Core": []
      }
    },
    {
      "name": "PopupInView",
      "source_files": "CJPopupAction/Product/**/*.{h,m}",
      "dependencies": {
        "CJPopupAction/SlideAnimation": []
      }
    },
    {
      "name": "ShowExtendView",
      "source_files": "CJPopupAction/ShowExtendView/**/*.{h,m}",
      "dependencies": {
        "CJPopupAction/PopupInView": []
      }
    }
  ]
}
