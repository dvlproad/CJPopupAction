CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EMBEDDED_CONTENT_CONTAINS_SWIFT = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/CJAnimationKit" "${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/CJPopupAction" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup" "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup-Swift"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/CJAnimationKit/CJAnimationKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit/CJBaseUIKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CJPopupAction/CJPopupAction.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit/CQDemoKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource/CQDemoResource.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Masonry/Masonry.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup-Swift/TSDemo_Popup_Swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup/TSDemo_Popup.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CJAnimationKit/CJAnimationKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit/CJBaseUIKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CJPopupAction/CJPopupAction.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit/CQDemoKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource/CQDemoResource.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Masonry/Masonry.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup/TSDemo_Popup.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup-Swift/TSDemo_Popup_Swift.framework/Headers" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CJAnimationKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CJPopupAction" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Masonry" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup-Swift"
OTHER_LDFLAGS = $(inherited) -framework "CJAnimationKit" -framework "CJBaseUIKit" -framework "CJPopupAction" -framework "CQDemoKit" -framework "CQDemoResource" -framework "Foundation" -framework "Masonry" -framework "QuartzCore" -framework "TSDemo_Popup" -framework "TSDemo_Popup_Swift" -framework "UIKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/CJAnimationKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/CJBaseUIKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/CJPopupAction" "-F${PODS_CONFIGURATION_BUILD_DIR}/CQDemoKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/CQDemoResource" "-F${PODS_CONFIGURATION_BUILD_DIR}/Masonry" "-F${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup" "-F${PODS_CONFIGURATION_BUILD_DIR}/TSDemo_Popup-Swift"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
